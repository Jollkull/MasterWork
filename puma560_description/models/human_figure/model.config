<?xml version="1.0"?>
<model>
  <name>human_figure</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <description>
    Human figure built from primitives for visual representation.
    Collision geometry is a single cylinder (0.5m diameter, 1.75m height),
    matching the simplified human model used in safety distance standards.
  </description>
</model>
